FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS ui-build-stage
WORKDIR /ui
COPY ui/package*.json ./
RUN npm install --legacy-peer-deps
COPY ui/ ./
RUN npm run build && \
    npm cache clean --force

# The digest pin was dropped: the pinned digest disappeared from quay.io and
# every build failed with "not found" because nothing refreshed it. Renovate
# (`pinDigests` in renovate.json) re-adds and maintains the `@sha256:...` pin
# once the Renovate GitHub App is installed for this repository.
FROM quay.io/nginx/nginx-unprivileged:1.31-alpine@sha256:b9241c6e7b8e9a862f129d8d4199ab64b10390949a78bdd5603379b32c844083 AS ui-production-stage
# No `apk upgrade` here: it would make the build non-reproducible -- Alpine
# package versions could drift over time. OS package patching comes with the
# base image tag instead. Never needed to switch to root for
# this, so the image now runs as the base's own nonroot `nginx` (uid 101)
# user throughout the build.
COPY --chown=101:101 --from=ui-build-stage /ui/dist /usr/share/nginx/html/
COPY --chown=101:101 ui/nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 ui/hooks /docker-entrypoint.d/
