FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS ui-build-stage
WORKDIR /ui
COPY ui/package*.json ./
RUN npm install --legacy-peer-deps
COPY ui/ ./
RUN npm run build && \
    npm cache clean --force

# Chainguard's free, publicly pullable hardened nginx image
# (https://images.chainguard.dev): rebuilt daily from source on Wolfi,
# typically with zero known CVEs. No shell, no package manager, runs as the
# nonroot user (uid 65532). The free tier only publishes the floating `latest`
# tag, so it is pinned by digest and Renovate bumps the digest.
#
# Because there is no shell, the image has no /docker-entrypoint.d/ hook
# mechanism: the configuration is static. ui/nginx.conf moves every runtime
# write to /tmp (readOnlyRootFilesystem-compatible); the SPA's config.json is
# provided by the Helm chart's ConfigMap.
FROM cgr.dev/chainguard/nginx:latest@sha256:a2bbeeda97bb059018d7a022b3d704e2c0ac55ca738e6f7654ae743189dac24e AS ui-production-stage

# Files stay owned by root: the nonroot runtime user only needs to read them.
COPY ui/nginx.conf /etc/nginx/nginx.conf
COPY ui/nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --from=ui-build-stage /ui/dist /usr/share/nginx/html/

EXPOSE 8080
