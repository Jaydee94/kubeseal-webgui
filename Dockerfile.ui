FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS ui-build-stage
WORKDIR /ui
COPY ui/package*.json ./
RUN npm install --legacy-peer-deps
COPY ui/ ./
RUN npm run build && \
    npm cache clean --force

FROM quay.io/nginx/nginx-unprivileged:1.31-alpine@sha256:901e944d1f4fc2bd077e8f5568b98c1f6f8cdacf6b97a87747c43134a339b9a7 AS ui-production-stage
# No `apk upgrade` here: it would make the build non-reproducible -- Alpine
# package versions could drift over time even though the base image digest
# above is pinned. Security patching for OS packages flows through Renovate
# bumping that pinned digest instead. Never needed to switch to root for
# this, so the image now runs as the base's own nonroot `nginx` (uid 101)
# user throughout the build.
COPY --chown=101:101 --from=ui-build-stage /ui/dist /usr/share/nginx/html/
COPY --chown=101:101 ui/nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 ui/hooks /docker-entrypoint.d/
