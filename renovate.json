{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "automerge": false,
      "commitMessageTopic": "{{depName}} digest"
    },
    {
      "description": "The Python builder (latest-dev) and runtime (latest) images in Dockerfile.api must move together: compiled wheels are tied to one CPython minor version.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["cgr.dev/chainguard/python"],
      "groupName": "chainguard python images"
    },
    {
      "description": "The image tags in the Helm values are written by the release workflow, never by Renovate.",
      "matchFileNames": ["chart/**"],
      "matchPackageNames": ["ghcr.io/jaydee94/kubeseal-webgui/**"],
      "enabled": false
    },
    {
      "description": "The supported Python range in pyproject.toml is a deliberate choice; the API image's interpreter comes from the digest-pinned Chainguard python images.",
      "matchPackageNames": ["python"],
      "matchManagers": ["poetry"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "The supported Node range is a deliberate choice; the Node base image in Dockerfile.ui is still updated.",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchManagers": ["poetry"],
      "matchFileNames": ["api/**"],
      "groupName": "api dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["ui/**"],
      "groupName": "ui dependencies"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["bitnami-labs/sealed-secrets"],
      "commitMessageTopic": "kubeseal CLI"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["Dockerfile.api"],
      "matchStrings": ["ARG KUBESEAL_VERSION=(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "bitnami-labs/sealed-secrets",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
